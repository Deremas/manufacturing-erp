generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id               String    @id @default(cuid())
  companyName      String
  logo             String?
  address          String?
  phone            String?
  email            String?
  tinNumber        String?
  vatNumber        String?
  defaultCurrency  String    @default("ETB")
  fiscalYearStart  DateTime?
  invoiceFooter    String?
  reportHeaderInfo String?
  isActive         Boolean   @default(true)
  isArchived       Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model User {
  id                           String                      @id @default(cuid())
  publicId        Int                       @unique @default(autoincrement())
  name                         String
  email                        String                      @unique
  username                     String?                     @unique
  password                     String?
  language                     String?                     @default("en")
  dateFormat                   String?                     @default("DD/MM/YYYY")
  itemsPerPage                 Int?                        @default(25)
  lastLogin                    DateTime?
  role                         String                      @default("user")
  phone                        String?
  avatar                       String?
  isActive                     Boolean                     @default(true)
  isArchived                   Boolean                     @default(false)
  createdAt                    DateTime                    @default(now())
  updatedAt                    DateTime                    @updatedAt
  roleId                       String?
  salesAllowPermissions        String[]                    @default([])
  salesDenyPermissions         String[]                    @default([])
  approvedApprovals            Approval[]                  @relation("ApprovedBy")
  assignedApprovals            Approval[]                  @relation("AssignedApprover")
  requestedApprovals           Approval[]                  @relation("RequestedBy")
  maintenanceAssetsCreated     Asset[]                     @relation("AssetCreatedBy")
  maintenanceAssetsResponsible Asset[]                     @relation("AssetResponsibleUser")
  maintenanceAssetsUpdated     Asset[]                     @relation("AssetUpdatedBy")
  assetReceiptsCreated         AssetReceipt[]
  auditLogs                    AuditLog[]
  bomsCreated                  BOM[]                       @relation("BOMCreatedBy")
  bomsUpdated                  BOM[]                       @relation("BOMUpdatedBy")
  dailyAttendanceApproved      DailyAttendance[]           @relation("DailyAttendanceApprovedBy")
  dailyAttendanceCreated       DailyAttendance[]           @relation("DailyAttendanceCreatedBy")
  dailyAttendanceUpdated       DailyAttendance[]           @relation("DailyAttendanceUpdatedBy")
  dailyAttendanceUser          DailyAttendance[]           @relation("DailyAttendanceUser")
  managedDepartments           Department[]
  documentAttachments          DocumentAttachment[]
  documentComments             DocumentComment[]
  documentHistories            DocumentHistory[]
  employeesCreated             Employee[]                  @relation("EmployeeCreatedBy")
  managedEmployees             Employee[]                  @relation("EmployeeManager")
  employeesUpdated             Employee[]                  @relation("EmployeeUpdatedBy")
  employeeProfile              Employee?                   @relation("EmployeeUserAccount")
  employeeDocumentsUploaded    EmployeeDocument[]          @relation("EmployeeDocumentUploadedBy")
  goodsReceiptsApproved        GoodsReceipt[]              @relation("GoodsReceiptApprovedBy")
  goodsReceiptsCreated         GoodsReceipt[]              @relation("GoodsReceiptCreatedBy")
  goodsReceiptsPosted          GoodsReceipt[]              @relation("GoodsReceiptPostedBy")
  itemsCreated                 Item[]                      @relation("ItemCreatedBy")
  itemsUpdated                 Item[]                      @relation("ItemUpdatedBy")
  journalEntriesPosted         JournalEntry[]              @relation("JournalEntryPostedBy")
  leaveRequestsFinalApproved   LeaveRequest[]              @relation("LeaveRequestFinalApprovedBy")
  leaveRequestsHrApproved      LeaveRequest[]              @relation("LeaveRequestHrApprovedBy")
  leaveRequestsManagerApproved LeaveRequest[]              @relation("LeaveRequestManagerApprovedBy")
  leaveRequestsCreated         LeaveRequest[]              @relation("LeaveRequestCreatedBy")
  locationsCreated             Location[]                  @relation("LocationCreatedBy")
  managedLocations             Location[]
  locationsUpdated             Location[]                  @relation("LocationUpdatedBy")
  maintenanceLaborEntries      MaintenanceLabor[]          @relation("MaintenanceLaborEmployee")
  maintenanceTicketsAssigned   MaintenanceTicket[]         @relation("MaintenanceTicketAssignedTo")
  maintenanceTicketsRequested  MaintenanceTicket[]         @relation("MaintenanceTicketRequestedBy")
  maintenanceWorkOrdersApprove MaintenanceWorkOrder[]      @relation("MaintenanceWorkOrderApprovedBy")
  maintenanceWorkOrdersTech    MaintenanceWorkOrder[]      @relation("MaintenanceWorkOrderTechnician")
  maintenanceWorkOrdersClosed  MaintenanceWorkOrder[]      @relation("MaintenanceWorkOrderClosedBy")
  maintenanceWorkOrdersDone    MaintenanceWorkOrder[]      @relation("MaintenanceWorkOrderCompletedBy")
  maintenanceWorkOrdersSuper   MaintenanceWorkOrder[]      @relation("MaintenanceWorkOrderSupervisor")
  overheadCostsCreated         OverheadCostSetting[]       @relation("OverheadCostCreatedBy")
  overheadCostsUpdated         OverheadCostSetting[]       @relation("OverheadCostUpdatedBy")
  overtimeRequestsApproved     OvertimeRequest[]           @relation("OvertimeRequestApprovedBy")
  overtimeRequestsCreated      OvertimeRequest[]           @relation("OvertimeRequestCreatedBy")
  payrollRunsApproved          PayrollRun[]                @relation("PayrollRunApprovedBy")
  payrollRunsCreated           PayrollRun[]                @relation("PayrollRunCreatedBy")
  payrollRunsPosted            PayrollRun[]                @relation("PayrollRunPostedBy")
  procurementFinancePosts      ProcurementFinancePosting[] @relation("ProcurementFinancePostedBy")
  productionBatchesCreated     ProductionBatch[]           @relation("ProductionBatchCreatedBy")
  productionBatchesPosted      ProductionBatch[]           @relation("ProductionBatchPostedBy")
  productionBatchesUpdated     ProductionBatch[]           @relation("ProductionBatchUpdatedBy")
  productionDowntimes          ProductionDowntime[]        @relation("ProductionDowntimeCreatedBy")
  productionIssuesCreated      ProductionMaterialIssue[]   @relation("ProductionMaterialIssueCreatedBy")
  productionIssuesPosted       ProductionMaterialIssue[]   @relation("ProductionMaterialIssuePostedBy")
  productionReturnsCreated     ProductionMaterialReturn[]  @relation("ProductionMaterialReturnCreatedBy")
  productionReturnsPosted      ProductionMaterialReturn[]  @relation("ProductionMaterialReturnPostedBy")
  qcHoldsCreated               QCHoldRelease[]             @relation("QCHoldCreatedBy")
  qcHoldsReleased              QCHoldRelease[]             @relation("QCHoldReleasedBy")
  qcNonconformitiesClosed      QCNonconformity[]           @relation("QCNonconformityClosedBy")
  qcNonconformitiesCreated     QCNonconformity[]           @relation("QCNonconformityCreatedBy")
  qcNonconformitiesResponsible QCNonconformity[]           @relation("QCNonconformityResponsible")
  qcTestsApproved              QCTest[]                    @relation("QCTestApprovedBy")
  qcTestsChecked               QCTest[]                    @relation("QCTestCheckedBy")
  qcTestsTested                QCTest[]                    @relation("QCTestTestedBy")
  qcTasksAssigned              QCTask[]                    @relation("QCTaskAssignedTo")
  shiftAttendances             ShiftAttendance[]
  shiftSessionsEnded           ShiftSession[]              @relation("ShiftSessionEndedBy")
  shiftSessionsStarted         ShiftSession[]              @relation("ShiftSessionStartedBy")
  stockAdjustmentsApproved     StockAdjustment[]           @relation("StockAdjustmentApprovedBy")
  stockAdjustmentsCreated      StockAdjustment[]           @relation("StockAdjustmentCreatedBy")
  stockAdjustmentsPosted       StockAdjustment[]           @relation("StockAdjustmentPostedBy")
  stockIssuesApproved          StockIssue[]                @relation("StockIssueApprovedBy")
  stockIssuesCreated           StockIssue[]                @relation("StockIssueCreatedBy")
  stockIssuesPosted            StockIssue[]                @relation("StockIssuePostedBy")
  stockMovementsCreated        StockMovement[]
  stockReturnsApproved         StockReturn[]               @relation("StockReturnApprovedBy")
  stockReturnsCreated          StockReturn[]               @relation("StockReturnCreatedBy")
  stockReturnsPosted           StockReturn[]               @relation("StockReturnPostedBy")
  stockTransfersApproved       StockTransfer[]             @relation("StockTransferApprovedBy")
  stockTransfersCreated        StockTransfer[]             @relation("StockTransferCreatedBy")
  stockTransfersPosted         StockTransfer[]             @relation("StockTransferPostedBy")
  requisitionsCreated          StoreRequisition[]          @relation("StoreRequisitionCreatedBy")
  roleRel                      Role?                       @relation(fields: [roleId], references: [id])
  assignedLocations            UserLocation[]              @relation("AssignedLocations")
  locations                    UserLocation[]
  departments                  UserDepartment[]
}

model Role {
  id          String           @id @default(cuid())
  publicId        Int                       @unique @default(autoincrement())
  name        String           @unique
  description String?
  isActive    Boolean          @default(true)
  isArchived  Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  isSystem    Boolean          @default(false)
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id              String           @id @default(cuid())
  module          String
  action          String
  label           String?
  isArchived      Boolean          @default(false)
  rolePermissions RolePermission[]
}

model RolePermission {
  id            String     @id @default(cuid())
  roleId        String
  permission    String
  module        String
  action        String
  isArchived    Boolean    @default(false)
  permissionRel Permission @relation(fields: [permission], references: [id])
  role          Role       @relation(fields: [roleId], references: [id])
}

model Location {
  id                      String                     @id @default(cuid())
  publicId        Int                       @unique @default(autoincrement())
  locationCode            String                     @unique
  locationName            String
  locationType            String
  address                 String?
  description             String?
  parentLocationId        String?
  displayOrder            Int?                       @default(0)
  city                    String?
  region                  String?
  country                 String?
  gpsLatitude             String?
  gpsLongitude            String?
  managerId               String?
  isStockLocation         Boolean                    @default(true)
  isProcurementLocation   Boolean                    @default(false)
  isProductionLocation    Boolean                    @default(false)
  isSalesLocation         Boolean                    @default(false)
  isTransitLocation       Boolean                    @default(false)
  isScrapLocation         Boolean                    @default(false)
  isQcHoldLocation        Boolean                    @default(false)
  isFinishedGoodsLocation Boolean                    @default(false)
  defaultPriceListId      String?
  defaultBankAccountId    String?
  allowNegativeStock      Boolean                    @default(false)
  requireTransferApproval Boolean                    @default(false)
  enableLocationNumbering Boolean                    @default(false)
  createdById             String?
  updatedById             String?
  isActive                Boolean                    @default(true)
  isArchived              Boolean                    @default(false)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  assets                  Asset[]
  dailyAttendance         DailyAttendance[]
  employees               Employee[]
  goodsReceipts           GoodsReceipt[]
  leaveRequests           LeaveRequest[]
  createdBy               User?                      @relation("LocationCreatedBy", fields: [createdById], references: [id])
  manager                 User?                      @relation(fields: [managerId], references: [id])
  parentLocation          Location?                  @relation("LocationHierarchy", fields: [parentLocationId], references: [id])
  childLocations          Location[]                 @relation("LocationHierarchy")
  updatedBy               User?                      @relation("LocationUpdatedBy", fields: [updatedById], references: [id])
  maintenanceTickets      MaintenanceTicket[]
  maintenanceWorkOrders   MaintenanceWorkOrder[]
  overtimeRequests        OvertimeRequest[]
  productionBatches       ProductionBatch[]
  productionBatchesOnHold ProductionBatch[]          @relation("ProductionBatchQcHoldLocation")
  productionBatchReleases ProductionBatch[]          @relation("ProductionBatchReleaseLocation")
  productionDowntimes     ProductionDowntime[]
  productionIssueFloors   ProductionMaterialIssue[]  @relation("ProductionIssueProductionLocation")
  productionIssueStores   ProductionMaterialIssue[]  @relation("ProductionIssueStoreLocation")
  productionReturnFroms   ProductionMaterialReturn[] @relation("ProductionReturnFromLocation")
  productionReturnStores  ProductionMaterialReturn[] @relation("ProductionReturnToStoreLocation")
  qcHoldReleases          QCHoldRelease[]
  qcHoldDestinations      QCHoldRelease[]            @relation("QCHoldDestinationLocation")
  qcNonconformities       QCNonconformity[]
  qcTests                 QCTest[]
  qcTasks                 QCTask[]
  qcDispositionsFrom      QCDisposition[]            @relation("QCDispositionFromLocation")
  qcDispositionsTo        QCDisposition[]            @relation("QCDispositionToLocation")
  shiftSessions           ShiftSession[]
  stockAdjustments        StockAdjustment[]
  stockBalances           StockBalance[]
  stockIssues             StockIssue[]
  stockMovements          StockMovement[]
  stockReturns            StockReturn[]
  stockTransfersFrom      StockTransfer[]            @relation("StockTransferFromLocation")
  stockTransfersTo        StockTransfer[]            @relation("StockTransferToLocation")
  storeRequisitionsFrom   StoreRequisition[]         @relation("StoreRequisitionFromLocation")
  storeRequisitionsTo     StoreRequisition[]         @relation("StoreRequisitionToLocation")
  userLocations           UserLocation[]
}

model UserLocation {
  id             String   @id @default(cuid())
  userId         String
  locationId     String
  assignedUserId String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  assignedUser   User?    @relation("AssignedLocations", fields: [assignedUserId], references: [id])
  location       Location @relation(fields: [locationId], references: [id])
  user           User     @relation(fields: [userId], references: [id])

  @@unique([userId, locationId])
}

model UserDepartment {
  id           String     @id @default(cuid())
  userId       String
  departmentId String
  isDefault    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@index([departmentId])
}

model SystemSetting {
  id         String  @id @default(cuid())
  key        String  @unique
  value      String
  category   String  @default("general")
  isArchived Boolean @default(false)
}

model Item {
  id                                 String                           @id @default(cuid())
  publicId        Int                       @unique @default(autoincrement())
  itemCode                           String                           @unique
  itemName                           String
  sku                                String?
  batchTracking                      Boolean                          @default(false)
  expiryTracking                     Boolean                          @default(false)
  serialTracking                     Boolean                          @default(false)
  categoryId                         String?
  itemTypeId                         String?
  uomId                              String?
  reorderPoint                       Float?                           @default(0)
  standardCost                       Float?                           @default(0)
  sellingPrice                       Float?                           @default(0)
  purchaseTaxCodeId                  String?
  vatApplicable                      Boolean                          @default(true)
  exciseApplicable                   Boolean                          @default(false)
  createdById                        String?
  updatedById                        String?
  isActive                           Boolean                          @default(true)
  isArchived                         Boolean                          @default(false)
  createdAt                          DateTime                         @default(now())
  updatedAt                          DateTime                         @updatedAt
  description                        String?
  maintenanceAssets                  Asset[]
  bomsAsFinishedGood                 BOM[]                            @relation("BOMFinishedGood")
  bomComponents                      BOMItem[]                        @relation("BOMComponentItem")
  goodsReceiptItems                  GoodsReceiptItem[]
  category                           Category?                        @relation(fields: [categoryId], references: [id])
  createdBy                          User?                            @relation("ItemCreatedBy", fields: [createdById], references: [id])
  itemType                           ItemType?                        @relation(fields: [itemTypeId], references: [id])
  uom                                Unit?                            @relation("ItemUOM", fields: [uomId], references: [id])
  updatedBy                          User?                            @relation("ItemUpdatedBy", fields: [updatedById], references: [id])
  maintenanceParts                   MaintenanceWorkOrderPart[]
  preventiveMaintenancePlannedSpares PreventiveMaintenancePlanSpare[]
  assetReceipts                      AssetReceipt[]
  priceListItems                     PriceListItem[]
  productionBatches                  ProductionBatch[]                @relation("ProductionBatchFinishedGood")
  productionIssueItems               ProductionMaterialIssueItem[]    @relation("ProductionMaterialIssueItem")
  productionReturnItems              ProductionMaterialReturnItem[]   @relation("ProductionMaterialReturnItem")
  qcHoldItems                        QCHoldRelease[]                  @relation("QCHoldReleaseItem")
  qcNonconformityItems               QCNonconformity[]                @relation("QCNonconformityItem")
  qcTestItems                        QCTest[]                         @relation("QCTestItem")
  qcTasks                            QCTask[]
  qcTestTemplates                    QCTestTemplate[]
  stockAdjustmentItems               StockAdjustmentItem[]
  stockBalances                      StockBalance[]
  stockIssueItems                    StockIssueItem[]
  stockMovements                     StockMovement[]
  stockReturnItems                   StockReturnItem[]
  stockTransferItems                 StockTransferItem[]
  storeRequisitionItems              StoreRequisitionItem[]
  supplierInvoiceItems               SupplierInvoiceItem[]
  qcdispositions                     QCDisposition[]
  assetSpareParts                    AssetSparePart[]
}

model Category {
  id               String     @id @default(cuid())
  publicId        Int                       @unique @default(autoincrement())
  code             String?    @unique
  name             String
  parentCategoryId String?
  description      String?
  displayOrder     Int?       @default(0)
  createdById      String?
  updatedById      String?
  isActive         Boolean    @default(true)
  isArchived       Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  assets           Asset[]
  parent           Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  children         Category[] @relation("CategoryHierarchy")
  items            Item[]
}

model Unit {
  id                            String                         @id @default(cuid())
  publicId        Int                       @unique @default(autoincrement())
  code                          String?                        @unique
  name                          String
  abbreviation                  String
  type                          String
  decimalPrecision              Int?                           @default(0)
  createdById                   String?
  updatedById                   String?
  isActive                      Boolean                        @default(true)
  isArchived                    Boolean                        @default(false)
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  boms                          BOM[]
  bomitems                      BOMItem[]
  items                         Item[]                         @relation("ItemUOM")
  priceListItems                PriceListItem[]
  productionMaterialIssueItems  ProductionMaterialIssueItem[]
  productionMaterialReturnItems ProductionMaterialReturnItem[]
  qcTemplateParameters          QCTestTemplateParameter[]
  conversionsFrom               UnitConversion[]               @relation("FromUnit")
  conversionsTo                 UnitConversion[]               @relation("ToUnit")
}

model Customer {
  id                     String            @id @default(cuid())
  publicId        Int                       @unique @default(autoincrement())
  customerCode           String            @unique
  name                   String
  customerType           String?
  tin                    String?
  vatRegistered          Boolean           @default(false)
  phone                  String?
  email                  String?
  address                String?
  city                   String?
  region                 String?
  creditLimit            Float?            @default(0)
  paymentTerms           String?
  defaultPriceListId     String?
  defaultSalesLocationId String?
  taxCodeId              String?
  remarks                String?
  createdById            String?
  updatedById            String?
  isActive               Boolean           @default(true)
  isArchived             Boolean           @default(false)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  addresses              CustomerAddress[]
  contacts               CustomerContact[]
}

model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  name       String
  phone      String?
  email      String?
  isPrimary  Boolean  @default(false)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  type       String?
  address    String?
  city       String?
  region     String?
  country    String?
  isPrimary  Boolean  @default(false)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id])
}

model Supplier {
  id                         String                      @id @default(cuid())
  publicId        Int                       @unique @default(autoincrement())
  supplierCode               String                      @unique
  name                       String
  contactPerson              String?
  tin                        String?
  vatRegistered              Boolean                     @default(false)
  phone                      String?
  email                      String?
  address                    String?
  city                       String?
  region                     String?
  paymentTerms               String?
  defaultBankId              String?
  defaultBankAccountId       String?
  taxCodeId                  String?
  remarks                    String?
  createdById                String?
  updatedById                String?
  isActive                   Boolean                     @default(true)
  isArchived                 Boolean                     @default(false)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  goodsReceipts              GoodsReceipt[]
  maintenanceExternalCosts   MaintenanceExternalCost[]
  procurementFinancePostings ProcurementFinancePosting[]
  addresses                  SupplierAddress[]
  contacts                   SupplierContact[]
  supplierInvoices           SupplierInvoice[]
  supplierPayments           SupplierPayment[]
}

model SupplierContact {
  id         String   @id @default(cuid())
  supplierId String
  name       String
  phone      String?
  email      String?
  isPrimary  Boolean  @default(false)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  supplier   Supplier @relation(fields: [supplierId], references: [id])
}

model SupplierAddress {
  id         String   @id @default(cuid())
  supplierId String
  type       String?
  address    String?
  city       String?
  region     String?
  country    String?
  isPrimary  Boolean  @default(false)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  supplier   Supplier @relation(fields: [supplierId], references: [id])
}

model Department {
  id                 String              @id @default(cuid())
  publicId        Int                       @unique @default(autoincrement())
  name               String
  code               String              @unique
  parentDepartmentId String?
  description        String?
  locationId         String?
  managerId          String?
  createdById        String?
  updatedById        String?
  isActive           Boolean             @default(true)
  isArchived         Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  maintenanceAssets  Asset[]
  manager            User?               @relation(fields: [managerId], references: [id])
  parentDepartment   Department?         @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id])
  childDepartments   Department[]        @relation("DepartmentHierarchy")
  employees          Employee[]
  leaveRequests      LeaveRequest[]
  maintenanceTickets MaintenanceTicket[]
  overtimeRequests   OvertimeRequest[]
  storeRequisitions  StoreRequisition[]
  userDepartments    UserDepartment[]
}

model Bank {
  id          String        @id @default(cuid())
  publicId        Int                       @unique @default(autoincrement())
  code        String?       @unique
  name        String
  shortName   String?
  swiftCode   String?
  description String?
  createdById String?
  updatedById String?
  isActive    Boolean       @default(true)
  isArchived  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  accounts    BankAccount[]
  employees   Employee[]
}

model BankAccount {
  id                 String                      @id @default(cuid())
  publicId        Int                       @unique @default(autoincrement())
  accountCode        String                      @unique
  accountName        String
  accountType        String?
  bankId             String
  accountNumber      String
  branch             String?
  swiftCode          String?
  locationId         String?
  currency           String                      @default("ETB")
  openingBalance     Float                       @default(0)
  currentBalance     Float                       @default(0)
  isDefault          Boolean                     @default(false)
  allowPayments      Boolean                     @default(true)
  allowReceipts      Boolean                     @default(true)
  openingBalanceDate DateTime?
  createdById        String?
  updatedById        String?
  isActive           Boolean                     @default(true)
  isArchived         Boolean                     @default(false)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  bank               Bank                        @relation(fields: [bankId], references: [id])
  financePostings    ProcurementFinancePosting[]
  supplierPayments   SupplierPayment[]
}

model BankTransfer {
  id                String             @id @default(cuid())
  publicId        Int                       @unique @default(autoincrement())
  transferNo        String             @unique
  transferDate      DateTime
  fromBankAccountId String
  toBankAccountId   String
  amount            Float
  currency          String             @default("ETB")
  status            BankTransferStatus @default(DRAFT)
  referenceNo       String?
  remarks           String?
  createdById       String
  postedById        String?
  postedAt          DateTime?
  reversedById      String?
  reversedAt        DateTime?
  reversalReason    String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([transferDate])
  @@index([fromBankAccountId])
  @@index([toBankAccountId])
  @@index([status])
}

model BankReconciliation {
  id                      String                   @id @default(cuid())
  publicId        Int                       @unique @default(autoincrement())
  reconciliationNo        String                   @unique
  bankAccountId           String
  periodFrom              DateTime
  periodTo                DateTime
  statementOpeningBalance Float
  statementClosingBalance Float
  systemClosingBalance    Float
  variance                Float
  status                  BankReconciliationStatus @default(DRAFT)
  remarks                 String?
  createdById             String
  reconciledById          String?
  reconciledAt            DateTime?
  reopenedById            String?
  reopenedAt              DateTime?
  reopenReason            String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([bankAccountId])
  @@index([periodFrom, periodTo])
  @@index([status])
}

model Employee {
  id                       String                      @id @default(cuid())
  publicId        Int                       @unique @default(autoincrement())
  employeeNo               String                      @unique
  firstName                String
  middleName               String?
  lastName                 String
  gender                   String?
  dateOfBirth              DateTime?
  phone                    String?
  email                    String?
  address                  String?
  hireDate                 DateTime
  employmentType           String?
  departmentId             String?
  locationId               String?
  positionTitle            String?
  productionRole           String?
  baseShiftCode            String?
  managerId                String?
  bankId                   String?
  bankAccountNumber        String?
  tin                      String?
  pensionNumber            String?
  baseSalary               Float                       @default(0)
  status                   EmployeeStatus              @default(ACTIVE)
  userId                   String?                     @unique
  emergencyContactName     String?
  emergencyContactPhone    String?
  guarantorName            String?
  guarantorPhone           String?
  guarantorDocumentUrl     String?
  medicalCertificateExpiry DateTime?
  isActive                 Boolean                     @default(true)
  isArchived               Boolean                     @default(false)
  createdById              String?
  updatedById              String?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  dailyAttendance          DailyAttendance[]
  bank                     Bank?                       @relation(fields: [bankId], references: [id])
  createdBy                User?                       @relation("EmployeeCreatedBy", fields: [createdById], references: [id])
  department               Department?                 @relation(fields: [departmentId], references: [id])
