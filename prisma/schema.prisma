generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id               String    @id @default(cuid())
  companyName      String
  logo             String?
  address          String?
  phone            String?
  email            String?
  tinNumber        String?
  vatNumber        String?
  defaultCurrency  String    @default("ETB")
  fiscalYearStart  DateTime?
  invoiceFooter    String?
  reportHeaderInfo String?
  isActive         Boolean   @default(true)
  isArchived       Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model User {
  id                           String                      @id @default(cuid())
  name                         String
  email                        String                      @unique
  username                     String?                     @unique
  password                     String?
  language                     String?                     @default("en")
  dateFormat                   String?                     @default("DD/MM/YYYY")
  itemsPerPage                 Int?                        @default(25)
  lastLogin                    DateTime?
  role                         String                      @default("user")
  phone                        String?
  avatar                       String?
  isActive                     Boolean                     @default(true)
  isArchived                   Boolean                     @default(false)
  createdAt                    DateTime                    @default(now())
  updatedAt                    DateTime                    @updatedAt
  roleId                       String?
  roleRel                      Role?                       @relation(fields: [roleId], references: [id])
  locations                    UserLocation[]
  assignedLocations            UserLocation[]              @relation("AssignedLocations")
  auditLogs                    AuditLog[]
  managedDepartments           Department[]
  managedLocations             Location[]
  locationsCreated             Location[]                  @relation("LocationCreatedBy")
  locationsUpdated             Location[]                  @relation("LocationUpdatedBy")
  itemsCreated                 Item[]                      @relation("ItemCreatedBy")
  itemsUpdated                 Item[]                      @relation("ItemUpdatedBy")
  documentAttachments          DocumentAttachment[]
  documentComments             DocumentComment[]
  documentHistories            DocumentHistory[]
  stockMovementsCreated        StockMovement[]
  requestedApprovals           Approval[]                  @relation("RequestedBy")
  approvedApprovals            Approval[]                  @relation("ApprovedBy")
  assignedApprovals            Approval[]                  @relation("AssignedApprover")
  stockTransfersCreated        StockTransfer[]             @relation("StockTransferCreatedBy")
  stockTransfersApproved       StockTransfer[]             @relation("StockTransferApprovedBy")
  stockTransfersPosted         StockTransfer[]             @relation("StockTransferPostedBy")
  stockAdjustmentsCreated      StockAdjustment[]           @relation("StockAdjustmentCreatedBy")
  stockAdjustmentsApproved     StockAdjustment[]           @relation("StockAdjustmentApprovedBy")
  stockAdjustmentsPosted       StockAdjustment[]           @relation("StockAdjustmentPostedBy")
  stockIssuesCreated           StockIssue[]                @relation("StockIssueCreatedBy")
  stockIssuesApproved          StockIssue[]                @relation("StockIssueApprovedBy")
  stockIssuesPosted            StockIssue[]                @relation("StockIssuePostedBy")
  stockReturnsCreated          StockReturn[]               @relation("StockReturnCreatedBy")
  stockReturnsApproved         StockReturn[]               @relation("StockReturnApprovedBy")
  stockReturnsPosted           StockReturn[]               @relation("StockReturnPostedBy")
  requisitionsCreated          StoreRequisition[]          @relation("StoreRequisitionCreatedBy")
  goodsReceiptsCreated         GoodsReceipt[]              @relation("GoodsReceiptCreatedBy")
  goodsReceiptsApproved        GoodsReceipt[]              @relation("GoodsReceiptApprovedBy")
  goodsReceiptsPosted          GoodsReceipt[]              @relation("GoodsReceiptPostedBy")
  procurementFinancePosts      ProcurementFinancePosting[] @relation("ProcurementFinancePostedBy")
  journalEntriesPosted         JournalEntry[]              @relation("JournalEntryPostedBy")
  bomsCreated                  BOM[]                       @relation("BOMCreatedBy")
  bomsUpdated                  BOM[]                       @relation("BOMUpdatedBy")
  overheadCostsCreated         OverheadCostSetting[]       @relation("OverheadCostCreatedBy")
  overheadCostsUpdated         OverheadCostSetting[]       @relation("OverheadCostUpdatedBy")
  shiftSessionsStarted         ShiftSession[]              @relation("ShiftSessionStartedBy")
  shiftSessionsEnded           ShiftSession[]              @relation("ShiftSessionEndedBy")
  shiftAttendances             ShiftAttendance[]
  productionBatchesPosted      ProductionBatch[]           @relation("ProductionBatchPostedBy")
  productionBatchesCreated     ProductionBatch[]           @relation("ProductionBatchCreatedBy")
  productionBatchesUpdated     ProductionBatch[]           @relation("ProductionBatchUpdatedBy")
  productionIssuesPosted       ProductionMaterialIssue[]   @relation("ProductionMaterialIssuePostedBy")
  productionIssuesCreated      ProductionMaterialIssue[]   @relation("ProductionMaterialIssueCreatedBy")
  productionReturnsPosted      ProductionMaterialReturn[]  @relation("ProductionMaterialReturnPostedBy")
  productionReturnsCreated     ProductionMaterialReturn[]  @relation("ProductionMaterialReturnCreatedBy")
  productionDowntimes          ProductionDowntime[]        @relation("ProductionDowntimeCreatedBy")
  qcTestsTested                QCTest[]                    @relation("QCTestTestedBy")
  qcTestsApproved              QCTest[]                    @relation("QCTestApprovedBy")
  qcHoldsReleased              QCHoldRelease[]             @relation("QCHoldReleasedBy")
  qcHoldsCreated               QCHoldRelease[]             @relation("QCHoldCreatedBy")
  qcNonconformitiesResponsible QCNonconformity[]           @relation("QCNonconformityResponsible")
  qcNonconformitiesCreated     QCNonconformity[]           @relation("QCNonconformityCreatedBy")
  qcNonconformitiesClosed      QCNonconformity[]           @relation("QCNonconformityClosedBy")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  isActive    Boolean          @default(true)
  isArchived  Boolean          @default(false)
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id              String           @id @default(cuid())
  module          String
  action          String
  label           String?
  isArchived      Boolean          @default(false)
  rolePermissions RolePermission[]
}

model RolePermission {
  id            String      @id @default(cuid())
  roleId        String
  role          Role        @relation(fields: [roleId], references: [id])
  permission    String
  module        String
  action        String
  isArchived    Boolean     @default(false)
  permissionRel Permission? @relation(fields: [permission], references: [id])
}

model Location {
  id                      String                     @id @default(cuid())
  locationCode            String                     @unique
  locationName            String
  locationType            String
  address                 String?
  description             String?
  parentLocationId        String?
  parentLocation          Location?                  @relation("LocationHierarchy", fields: [parentLocationId], references: [id])
  childLocations          Location[]                 @relation("LocationHierarchy")
  displayOrder            Int?                       @default(0)
  city                    String?
  region                  String?
  country                 String?
  gpsLatitude             String?
  gpsLongitude            String?
  managerId               String?
  manager                 User?                      @relation(fields: [managerId], references: [id])
  isStockLocation         Boolean                    @default(true)
  isProcurementLocation   Boolean                    @default(false)
  isProductionLocation    Boolean                    @default(false)
  isSalesLocation         Boolean                    @default(false)
  isTransitLocation       Boolean                    @default(false)
  isScrapLocation         Boolean                    @default(false)
  defaultPriceListId      String?
  defaultBankAccountId    String?
  allowNegativeStock      Boolean                    @default(false)
  requireTransferApproval Boolean                    @default(false)
  enableLocationNumbering Boolean                    @default(false)
  createdById             String?
  createdBy               User?                      @relation("LocationCreatedBy", fields: [createdById], references: [id])
  updatedById             String?
  updatedBy               User?                      @relation("LocationUpdatedBy", fields: [updatedById], references: [id])
  isActive                Boolean                    @default(true)
  isArchived              Boolean                    @default(false)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  userLocations           UserLocation[]
  stockBalances           StockBalance[]
  stockMovements          StockMovement[]
  stockTransfersFrom      StockTransfer[]            @relation("StockTransferFromLocation")
  stockTransfersTo        StockTransfer[]            @relation("StockTransferToLocation")
  stockAdjustments        StockAdjustment[]
  stockIssues             StockIssue[]
  stockReturns            StockReturn[]
  storeRequisitionsFrom   StoreRequisition[]         @relation("StoreRequisitionFromLocation")
  storeRequisitionsTo     StoreRequisition[]         @relation("StoreRequisitionToLocation")
  goodsReceipts           GoodsReceipt[]
  shiftSessions           ShiftSession[]
  productionBatches       ProductionBatch[]
  productionIssueStores   ProductionMaterialIssue[]  @relation("ProductionIssueStoreLocation")
  productionIssueFloors   ProductionMaterialIssue[]  @relation("ProductionIssueProductionLocation")
  productionReturnFroms   ProductionMaterialReturn[] @relation("ProductionReturnFromLocation")
  productionReturnStores  ProductionMaterialReturn[] @relation("ProductionReturnToStoreLocation")
  qcTests                 QCTest[]
  qcHoldReleases          QCHoldRelease[]
  qcNonconformities       QCNonconformity[]
}

model UserLocation {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  locationId     String
  location       Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  assignedUserId String?
  assignedUser   User?    @relation("AssignedLocations", fields: [assignedUserId], references: [id])
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@unique([userId, locationId])
}

model SystemSetting {
  id         String  @id @default(cuid())
  key        String  @unique
  value      String
  category   String  @default("general")
  isArchived Boolean @default(false)
}

// Master Data Models
model Item {
  id                    String                         @id @default(cuid())
  itemCode              String                         @unique
  itemName              String
  sku                   String?
  description           String?
  categoryId            String?
  category              Category?                      @relation(fields: [categoryId], references: [id])
  itemTypeId            String?
  itemType              ItemType?                      @relation(fields: [itemTypeId], references: [id])
  uomId                 String?
  uom                   Unit?                          @relation("ItemUOM", fields: [uomId], references: [id])
  batchTracking         Boolean                        @default(false)
  reorderPoint          Float?                         @default(0)
  standardCost          Float?                         @default(0)
  sellingPrice          Float?                         @default(0)
  expiryTracking        Boolean                        @default(false)
  serialTracking        Boolean                        @default(false)
  purchaseTaxCodeId     String?
  vatApplicable         Boolean                        @default(true)
  exciseApplicable      Boolean                        @default(false)
  createdById           String?
  createdBy             User?                          @relation("ItemCreatedBy", fields: [createdById], references: [id])
  updatedById           String?
  updatedBy             User?                          @relation("ItemUpdatedBy", fields: [updatedById], references: [id])
  isActive              Boolean                        @default(true)
  isArchived            Boolean                        @default(false)
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  stockBalances         StockBalance[]
  stockMovements        StockMovement[]
  priceListItems        PriceListItem[]
  stockTransferItems    StockTransferItem[]
  stockAdjustmentItems  StockAdjustmentItem[]
  stockIssueItems       StockIssueItem[]
  stockReturnItems      StockReturnItem[]
  storeRequisitionItems StoreRequisitionItem[]
  goodsReceiptItems     GoodsReceiptItem[]
  supplierInvoiceItems  SupplierInvoiceItem[]
  bomsAsFinishedGood    BOM[]                          @relation("BOMFinishedGood")
  bomComponents         BOMItem[]                      @relation("BOMComponentItem")
  productionBatches     ProductionBatch[]              @relation("ProductionBatchFinishedGood")
  productionIssueItems  ProductionMaterialIssueItem[]  @relation("ProductionMaterialIssueItem")
  productionReturnItems ProductionMaterialReturnItem[] @relation("ProductionMaterialReturnItem")
  qcTestItems           QCTest[]                       @relation("QCTestItem")
  qcHoldItems           QCHoldRelease[]                @relation("QCHoldReleaseItem")
  qcNonconformityItems  QCNonconformity[]              @relation("QCNonconformityItem")
}

model Category {
  id               String     @id @default(cuid())
  code             String?    @unique
  name             String
  parentCategoryId String?
  parent           Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  children         Category[] @relation("CategoryHierarchy")
  description      String?
  displayOrder     Int?       @default(0)
  createdById      String?
  updatedById      String?
  isActive         Boolean    @default(true)
  isArchived       Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  items            Item[]
}

model Unit {
  id                            String                         @id @default(cuid())
  code                          String?                        @unique
  name                          String
  abbreviation                  String
  type                          String
  decimalPrecision              Int?                           @default(0)
  createdById                   String?
  updatedById                   String?
  isActive                      Boolean                        @default(true)
  isArchived                    Boolean                        @default(false)
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  items                         Item[]                         @relation("ItemUOM")
  priceListItems                PriceListItem[]
  conversionsFrom               UnitConversion[]               @relation("FromUnit")
  conversionsTo                 UnitConversion[]               @relation("ToUnit")
  boms                          BOM[]
  bomitems                      BOMItem[]
  productionMaterialIssueItems  ProductionMaterialIssueItem[]
  productionMaterialReturnItems ProductionMaterialReturnItem[]
}

model Customer {
  id                     String            @id @default(cuid())
  customerCode           String            @unique
  name                   String
  customerType           String?
  tin                    String?
  vatRegistered          Boolean           @default(false)
  phone                  String?
  email                  String?
  address                String?
  city                   String?
  region                 String?
  creditLimit            Float?            @default(0)
  paymentTerms           String?
  defaultPriceListId     String?
  defaultSalesLocationId String?
  taxCodeId              String?
  remarks                String?
  createdById            String?
  updatedById            String?
  isActive               Boolean           @default(true)
  isArchived             Boolean           @default(false)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  contacts               CustomerContact[]
  addresses              CustomerAddress[]
}

model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  name       String
  phone      String?
  email      String?
  isPrimary  Boolean  @default(false)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  type       String?
  address    String?
  city       String?
  region     String?
  country    String?
  isPrimary  Boolean  @default(false)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Supplier {
  id                         String                      @id @default(cuid())
  supplierCode               String                      @unique
  name                       String
  contactPerson              String?
  tin                        String?
  vatRegistered              Boolean                     @default(false)
  phone                      String?
  email                      String?
  address                    String?
  city                       String?
  region                     String?
  paymentTerms               String?
  defaultBankId              String?
  defaultBankAccountId       String?
  taxCodeId                  String?
  remarks                    String?
  createdById                String?
  updatedById                String?
  isActive                   Boolean                     @default(true)
  isArchived                 Boolean                     @default(false)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  contacts                   SupplierContact[]
  addresses                  SupplierAddress[]
  goodsReceipts              GoodsReceipt[]
  supplierInvoices           SupplierInvoice[]
  supplierPayments           SupplierPayment[]
  procurementFinancePostings ProcurementFinancePosting[]
}

model SupplierContact {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  name       String
  phone      String?
  email      String?
  isPrimary  Boolean  @default(false)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SupplierAddress {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  type       String?
  address    String?
  city       String?
  region     String?
  country    String?
  isPrimary  Boolean  @default(false)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Department {
  id                 String             @id @default(cuid())
  name               String
  code               String             @unique
  parentDepartmentId String?
  parentDepartment   Department?        @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id])
  childDepartments   Department[]       @relation("DepartmentHierarchy")
  description        String?
  locationId         String?
  managerId          String?
  manager            User?              @relation(fields: [managerId], references: [id])
  createdById        String?
  updatedById        String?
  isActive           Boolean            @default(true)
  isArchived         Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  storeRequisitions  StoreRequisition[]
}

model Bank {
  id          String        @id @default(cuid())
  code        String?       @unique
  name        String
  shortName   String?
  swiftCode   String?
  description String?
  createdById String?
  updatedById String?
  isActive    Boolean       @default(true)
  isArchived  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  accounts    BankAccount[]
}

model BankAccount {
  id                 String                      @id @default(cuid())
  accountCode        String                      @unique
  accountName        String
  bankId             String
  bank               Bank                        @relation(fields: [bankId], references: [id])
  accountNumber      String
  branch             String?
  swiftCode          String?
  locationId         String?
  currency           String                      @default("ETB")
  openingBalance     Float                       @default(0)
  currentBalance     Float                       @default(0)
  isDefault          Boolean                     @default(false)
  allowPayments      Boolean                     @default(true)
  allowReceipts      Boolean                     @default(true)
  openingBalanceDate DateTime?
  createdById        String?
  updatedById        String?
  isActive           Boolean                     @default(true)
  isArchived         Boolean                     @default(false)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  supplierPayments   SupplierPayment[]
  financePostings    ProcurementFinancePosting[]
}

model PriceList {
  id            String          @id @default(cuid())
  code          String?         @unique
  name          String?
  currency      String          @default("ETB")
  customerGroup String?
  price         Float?
  effectiveDate DateTime?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  customerId    String?
  locationId    String?
  createdById   String?
  updatedById   String?
  isActive      Boolean         @default(true)
  isArchived    Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  items         PriceListItem[]
}

model PriceListItem {
  id           String    @id @default(cuid())
  priceListId  String
  priceList    PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  itemId       String
  item         Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  unitId       String?
  unit         Unit?     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  sellingPrice Float
  minimumPrice Float?
  taxIncluded  Boolean   @default(false)
  isActive     Boolean   @default(true)
  isArchived   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([priceListId, itemId])
}

model TaxCode {
  id          String   @id @default(cuid())
  code        String?  @unique
  taxName     String
  taxType     String
  rate        Float
  description String?
  appliesTo   String?  @default("BOTH")
  isDefault   Boolean  @default(false)
  createdById String?
  updatedById String?
  isActive    Boolean  @default(true)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ItemType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  isArchived  Boolean  @default(false)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       Item[]
}

// Document Numbering
model DocumentNumbering {
  id              String  @id @default(cuid())
  prefix          String  @unique
  description     String?
  prefixFormat    String  @default("PREFIX")
  separator       String  @default("")
  yearFormat      String  @default("YYYY")
  monthFormat     String  @default("MM")
  dayFormat       String  @default("DD")
  sequenceLength  Int     @default(4)
  currentSequence Int     @default(0)
  isActive        Boolean @default(true)
  isArchived      Boolean @default(false)
}

// Audit Log
model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  module     String
  recordId   String?
  oldValue   String?
  newValue   String?
  ipAddress  String?
  userAgent  String?
  isArchived Boolean  @default(false)
  timestamp  DateTime @default(now())
}

// Inventory Models
model StockBalance {
  id                String    @id @default(cuid())
  itemId            String
  item              Item      @relation(fields: [itemId], references: [id])
  locationId        String
  location          Location  @relation(fields: [locationId], references: [id])
  quantity          Float     @default(0)
  reservedQuantity  Float     @default(0)
  availableQuantity Float     @default(0)
  averageCost       Float     @default(0)
  lastMovementDate  DateTime?
  isArchived        Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([itemId, locationId])
}

model StockMovement {
  id               String            @id @default(cuid())
  movementNumber   String            @unique
  date             DateTime          @default(now())
  itemId           String
  item             Item              @relation(fields: [itemId], references: [id])
  locationId       String
  location         Location          @relation(fields: [locationId], references: [id])
  movementType     StockMovementType
  sourceModule     String?
  sourceDocumentId String?
  quantityIn       Float             @default(0)
  quantityOut      Float             @default(0)
  unitCost         Float?
  totalCost        Float?
  referenceType    String?
  referenceId      String?
  remarks          String?
  createdById      String
  createdBy        User              @relation(fields: [createdById], references: [id])
  isArchived       Boolean           @default(false)
  createdAt        DateTime          @default(now())
}

enum StockMovementType {
  OPENING
  PURCHASE_RECEIPT
  PURCHASE_RETURN
  PRODUCTION_ISSUE
  PRODUCTION_RECEIPT
  SALES_ISSUE
  SALES_RETURN
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  STORE_ISSUE
  STORE_RETURN
  SCRAP
  DAMAGED
  EXPIRED
}

enum InventoryDocumentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  POSTED
  CANCELLED
  PARTIALLY_ISSUED
  ISSUED
}

model StockTransfer {
  id             String                  @id @default(cuid())
  transferNo     String                  @unique
  transferDate   DateTime
  fromLocationId String
  fromLocation   Location                @relation("StockTransferFromLocation", fields: [fromLocationId], references: [id])
  toLocationId   String
  toLocation     Location                @relation("StockTransferToLocation", fields: [toLocationId], references: [id])
  status         InventoryDocumentStatus @default(DRAFT)
  remarks        String?
  createdById    String
  createdBy      User                    @relation("StockTransferCreatedBy", fields: [createdById], references: [id])
  approvedById   String?
  approvedBy     User?                   @relation("StockTransferApprovedBy", fields: [approvedById], references: [id])
  postedById     String?
  postedBy       User?                   @relation("StockTransferPostedBy", fields: [postedById], references: [id])
  postedAt       DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  items          StockTransferItem[]
}

model StockTransferItem {
  id         String        @id @default(cuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item          @relation(fields: [itemId], references: [id])
  quantity   Float
  unitCost   Float
  remarks    String?
}

model StockAdjustment {
  id             String                  @id @default(cuid())
  adjustmentNo   String                  @unique
  adjustmentDate DateTime
  locationId     String
  location       Location                @relation(fields: [locationId], references: [id])
  reason         String
  status         InventoryDocumentStatus @default(DRAFT)
  remarks        String?
  createdById    String
  createdBy      User                    @relation("StockAdjustmentCreatedBy", fields: [createdById], references: [id])
  approvedById   String?
  approvedBy     User?                   @relation("StockAdjustmentApprovedBy", fields: [approvedById], references: [id])
  postedById     String?
  postedBy       User?                   @relation("StockAdjustmentPostedBy", fields: [postedById], references: [id])
  postedAt       DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  items          StockAdjustmentItem[]
}

model StockAdjustmentItem {
  id            String          @id @default(cuid())
  adjustmentId  String
  adjustment    StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  itemId        String
  item          Item            @relation(fields: [itemId], references: [id])
  systemQty     Float
  physicalQty   Float
  differenceQty Float
  unitCost      Float
  remarks       String?
}

model StockIssue {
  id           String                  @id @default(cuid())
  issueNo      String                  @unique
  issueDate    DateTime
  locationId   String
  location     Location                @relation(fields: [locationId], references: [id])
  issuedToType String
  issuedToId   String
  purpose      String
