model QCTestRecord {
  id                      String             @id @default(cuid())
  publicId        Int                       @unique @default(autoincrement())
  recordNo                String             @unique
  testTypeId              String
  controlledFormId        String
  recordDate              DateTime
  shiftCode               String?
  itemId                  String?
  supplierId              String?
  samplePointId           String?
  batchNo                 String?
  locationId              String?
  assetId                 String?
  quantity                Float?
  formVersion             Int                @default(1)
  formCodeSnapshot        String
  formTitleSnapshot       String
  frequencySnapshot       String?
  specificationSnapshot   Json?
  extraFields             Json?
  result                  String             @default("PENDING")
  status                  String             @default("DRAFT")
