{
  "name": "new-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:normalize-codes": "tsx scripts/normalize-document-codes.ts",
    "db:restore-numbering": "tsx scripts/restore-document-numbering.ts",
    "db:public-id": "tsx scripts/apply-public-id.ts",
    "db:seed-stock": "tsx scripts/seed-opening-stock.ts",
    "db:purge-test-items": "tsx scripts/purge-non-agro-items.ts",
    "test:inventory": "node --test --test-concurrency=1 --import tsx tests/inventory/*.test.ts tests/procurement/*.test.ts",
    "test:production": "node --test --test-concurrency=1 --import tsx tests/production/*.test.ts",
    "test:maintenance": "node --test --test-concurrency=1 --import tsx tests/maintenance/*.test.ts",
    "test:hr": "node --test --test-concurrency=1 --import tsx tests/hr/*.test.ts",
    "test:pricing": "node --test --test-concurrency=1 --import tsx tests/pricing/*.test.ts",
    "test:sales": "node --test --test-concurrency=1 --import tsx tests/sales/*.test.ts",
    "test:reports": "node --test --test-concurrency=1 --import tsx tests/reports/*.test.ts",
    "test:security": "node --test --test-concurrency=1 --import tsx tests/permissions/*.test.ts",
    "test:qc": "node --test --test-concurrency=1 --import tsx tests/qc/*.test.ts",
    "test:db:check": "tsx scripts/prepare-test-database.ts --check-only",
    "test:db:prepare": "tsx scripts/prepare-test-database.ts",
    "test:manufacturing": "npm run test:production && npm run test:qc && npm run test:sales",
    "test:all": "npm run test:security && npm run test:inventory && npm run test:production && npm run test:qc && npm run test:maintenance && npm run test:hr && npm run test:pricing && npm run test:sales && npm run test:reports",
    "test:inventory-regression": "tsx scripts/inventory-regression.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.21.0",
    "next": "^16.2.9",
    "next-auth": "^4.24.14",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
